# WoWCodes Backend Environment Variables
# Copy this file to .env and update values

# Database URL (SQLite for development, PostgreSQL for production)
# SQLite: sqlite:///./wowcodes.db
# PostgreSQL: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./wowcodes.db

# Secret key for JWT signing (change in production!)
SECRET_KEY=your-secret-key-change-me-in-production

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated)
# For Netlify frontend deployment
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://wowcodes.netlify.app

# Environment: development / production / test
ENVIRONMENT=development

# Password reset token expiry (minutes)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Email settings (for password reset - configure with your email provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Supabase (Production - optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=